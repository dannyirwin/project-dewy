# Copy to `.env` — loaded automatically by `pnpm dev`, `pnpm start`, `pnpm seed`, and other live scripts.
PORT=3000

# --- Supabase (local: values printed by `supabase start`) ---
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=replace-me
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# --- LLM provider (LM Studio local server) ---
CHAT_BASE_URL=http://127.0.0.1:1234/v1
CHAT_API_KEY=lm-studio
CHAT_MODEL=qwen2.5-14b-instruct

# --- Embeddings (LM Studio embedding model) ---
EMBEDDING_BASE_URL=http://127.0.0.1:1234/v1
EMBEDDING_API_KEY=lm-studio
EMBEDDING_MODEL=text-embedding-nomic-embed-text-v1.5
EMBEDDING_DIMENSION=768

# --- Pipeline ---
RECONCILIATION_STEP_BUDGET=12
PROPOSAL_STEP_BUDGET=20
STRUCTURED_OUTPUT_MAX_RETRIES=3
AUTO_APPLY_CONFIDENCE_THRESHOLD=0.85

# --- Retrieval ---
CHUNK_TARGET_TOKENS=400
CHUNK_OVERLAP_TOKENS=60
SEARCH_SEMANTIC_WEIGHT=1.0
SEARCH_KEYWORD_WEIGHT=1.0

# --- Auth (leave empty for local dev / offline tests; set before shared or remote deploy) ---
# MCP_TOKEN=dev-mcp-secret
# API_TOKEN=dev-api-secret
